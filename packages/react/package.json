{
    "name": "@ptrn/react",
    "version": "0.0.1",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "files": [
        "dist",
        "!dist/**/*Example.js",
        "!dist/**/*Example.d.ts",
        "!dist/**/*Example.css",
        "!dist/**/*Example.css.js",
        "!dist/components/ExamplePlaceholder",
        "README.md",
        "LICENSE",
        "NOTICE.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pttrn/pttrn",
        "directory": "packages/react"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "sass": "npx sass --no-source-map --pkg-importer=node --silence-deprecation=mixed-decls src:dist",
        "build": "npm run check:css-vars && npx tsx build.ts",
        "lint:css": "npx stylelint '**/*.scss'",
        "lint:css:fix": "npx stylelint '**/*.scss' --fix",
        "lint": "eslint && tsc --noEmit && stylelint '**/*.scss'",
        "lint:fix": "eslint --fix",
        "lint:specs": "tsx .scripts/tasks/lint-specs.ts",
        "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest",
        "meta": "tsx meta.ts",
        "pretty": "npx prettier --write src/",
        "newc": "tsx .scripts/tasks/new-component.ts",
        "create:tests": "tsx .scripts/tasks/create-tests.ts",
        "clean": "tsx .scripts/clean.ts",
        "pr-check": "npx tsx .scripts/tasks/lint-components.ts && npm run lint && npm run build && npm run test",
        "prepack": "node ../../scripts/copy-license.mjs",
        "postpack": "node ../../scripts/copy-license.mjs --clean",
        "check:css-vars": "node ../../scripts/check-css-vars.mjs src --base src/styles/base.scss --base src/styles/_color-variants.scss"
    },
    "static-exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
