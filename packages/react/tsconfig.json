{
    "compilerOptions": {
        "module": "ES2020",
        "target": "ES2020",
        "lib": ["ES2020", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "declaration": true,
        "sourceMap": true,
        "inlineSources": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "-/components/*": ["./src/components/*"],
            "-/hooks/*": ["./src/hooks/*"],
            "-/styles/*": ["./src/styles/*"],
            "-/utils/*": ["./src/utils/*"],
            "-/types/*": ["./src/types/*"],
            "-/constants/*": ["./src/constants/*"],
            "-/rtl/*": ["./src/rtl/*"],
            ".scripts/*": ["./.scripts/*"]
        },
        "moduleDetection": "auto",
        "types": ["node", "jest", "@testing-library/jest-dom"],
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "acceptance-tests", "package", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
