{
    "name": "@ptrn/styles",
    "version": "0.0.1",
    "license": "MIT",
    "description": "pttrn design tokens: the DTCG token source exported from the USWDS Design Kit in Figma, the stylesheets built from it, and the reset shared by @ptrn/react and @ptrn/web.",
    "files": [
        "*.css",
        "themes",
        "tokens",
        "tokens.js",
        "tokens.d.ts",
        "README.md",
        "LICENSE",
        "NOTICE.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pttrn/pttrn",
        "directory": "packages/styles"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsx build.ts",
        "tokens:import": "tsx scripts/css-to-dtcg.ts",
        "lint": "tsc --noEmit -p tsconfig.json",
        "prepack": "node ../../scripts/copy-license.mjs",
        "postpack": "node ../../scripts/copy-license.mjs --clean"
    },
    "exports": {
        "./tokens.css": "./tokens.css",
        "./fonts.css": "./fonts.css",
        "./reset.css": "./reset.css",
        "./reset": {
            "sass": "./reset.css",
            "style": "./reset.css",
            "default": "./reset.css"
        },
        "./themes/*.css": "./themes/*.css",
        "./tokens": {
            "types": "./tokens.d.ts",
            "default": "./tokens.js"
        },
        "./tokens/*": "./tokens/*",
        "./package.json": "./package.json",
        "./fonts.google.css": "./fonts.google.css"
    },
    "devDependencies": {
        "style-dictionary": "^5.7.0",
        "tsx": "^4.23.15"
    },
    "type": "module",
    "types": "./tokens.d.ts",
    "dependencies": {
        "@fontsource/merriweather": "^5.3.0",
        "@fontsource/public-sans": "^5.3.0",
        "@fontsource/roboto-mono": "^5.3.0"
    }
}
