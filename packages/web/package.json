{
    "name": "@ptrn/web",
    "version": "0.0.1",
    "description": "pttrn Web Components: framework-free custom elements built with Lit.",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "sideEffects": true,
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pttrn/pttrn",
        "directory": "packages/web"
    },
    "engines": {
        "node": ">=22"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "customElements": "dist/custom-elements.json",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./cdn": "./dist/cdn/pttrn-web.min.js",
        "./custom-elements.json": "./dist/custom-elements.json",
        "./Accordion": {
            "types": "./dist/components/Accordion/index.d.ts",
            "default": "./dist/components/Accordion/index.js"
        },
        "./Avatar": {
            "types": "./dist/components/Avatar/index.d.ts",
            "default": "./dist/components/Avatar/index.js"
        },
        "./Badge": {
            "types": "./dist/components/Badge/index.d.ts",
            "default": "./dist/components/Badge/index.js"
        },
        "./BadgeDot": {
            "types": "./dist/components/BadgeDot/index.d.ts",
            "default": "./dist/components/BadgeDot/index.js"
        },
        "./BannerAlert": {
            "types": "./dist/components/BannerAlert/index.d.ts",
            "default": "./dist/components/BannerAlert/index.js"
        },
        "./Button": {
            "types": "./dist/components/Button/index.d.ts",
            "default": "./dist/components/Button/index.js"
        },
        "./Card": {
            "types": "./dist/components/Card/index.d.ts",
            "default": "./dist/components/Card/index.js"
        },
        "./Chip": {
            "types": "./dist/components/Chip/index.d.ts",
            "default": "./dist/components/Chip/index.js"
        },
        "./ChipGroup": {
            "types": "./dist/components/ChipGroup/index.d.ts",
            "default": "./dist/components/ChipGroup/index.js"
        },
        "./Divider": {
            "types": "./dist/components/Divider/index.d.ts",
            "default": "./dist/components/Divider/index.js"
        },
        "./EmptyState": {
            "types": "./dist/components/EmptyState/index.d.ts",
            "default": "./dist/components/EmptyState/index.js"
        },
        "./Fab": {
            "types": "./dist/components/Fab/index.d.ts",
            "default": "./dist/components/Fab/index.js"
        },
        "./InlineAlert": {
            "types": "./dist/components/InlineAlert/index.d.ts",
            "default": "./dist/components/InlineAlert/index.js"
        },
        "./Input": {
            "types": "./dist/components/Input/index.d.ts",
            "default": "./dist/components/Input/index.js"
        },
        "./InputNumber": {
            "types": "./dist/components/InputNumber/index.d.ts",
            "default": "./dist/components/InputNumber/index.js"
        },
        "./Password": {
            "types": "./dist/components/Password/index.d.ts",
            "default": "./dist/components/Password/index.js"
        },
        "./RadioGroup": {
            "types": "./dist/components/RadioGroup/index.d.ts",
            "default": "./dist/components/RadioGroup/index.js"
        },
        "./SearchBar": {
            "types": "./dist/components/SearchBar/index.d.ts",
            "default": "./dist/components/SearchBar/index.js"
        },
        "./Skeleton": {
            "types": "./dist/components/Skeleton/index.d.ts",
            "default": "./dist/components/Skeleton/index.js"
        },
        "./SkeletonText": {
            "types": "./dist/components/SkeletonText/index.d.ts",
            "default": "./dist/components/SkeletonText/index.js"
        },
        "./Switch": {
            "types": "./dist/components/Switch/index.d.ts",
            "default": "./dist/components/Switch/index.js"
        },
        "./SwitchOption": {
            "types": "./dist/components/SwitchOption/index.d.ts",
            "default": "./dist/components/SwitchOption/index.js"
        },
        "./Tag": {
            "types": "./dist/components/Tag/index.d.ts",
            "default": "./dist/components/Tag/index.js"
        },
        "./Textarea": {
            "types": "./dist/components/Textarea/index.d.ts",
            "default": "./dist/components/Textarea/index.js"
        },
        "./Txt": {
            "types": "./dist/components/Txt/index.d.ts",
            "default": "./dist/components/Txt/index.js"
        }
    },
    "scripts": {
        "build": "npm run check:css-vars && tsx build.ts",
        "newc": "tsx .scripts/new-component.ts",
        "lint": "eslint && tsc --noEmit && stylelint '**/*.scss'",
        "lint:fix": "eslint --fix",
        "test": "playwright test",
        "prepack": "node ../../scripts/copy-license.mjs",
        "postpack": "node ../../scripts/copy-license.mjs --clean",
        "check:css-vars": "node ../../scripts/check-css-vars.mjs src"
    },
    "dependencies": {
        "lit": "^3.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.1",
        "@custom-elements-manifest/analyzer": "^0.11.0",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.50.1",
        "@ptrn/icons": "*",
        "@ptrn/styles": "*",
        "@types/node": "^22.10.2",
        "esbuild": "^0.28.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^15.12.0",
        "sass": "^1.89.2",
        "stylelint": "^16.19.1",
        "stylelint-config-standard-scss": "^14.0.0",
        "tsx": "^4.19.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.49.0"
    }
}
