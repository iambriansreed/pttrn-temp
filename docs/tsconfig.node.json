{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "jsx": "preserve",
        "paths": {
            "src/*": ["./src/*"],
            "components/*": ["./src/components/*"],
            "utils/*": ["./src/utils/*"],
            "tests/*": ["./tests/*"],
            "-/components/*": ["../packages/react/src/components/*"],
            "-/hooks/*": ["../packages/react/src/hooks/*"],
            "-/utils/*": ["../packages/react/src/utils/*"],
            "-/types/*": ["../packages/react/src/types/*"],
            "-/constants/*": ["../packages/react/src/constants/*"],
            "-/styles/*": ["../packages/react/src/styles/*"]
        }
    },
    "include": ["vite.config.ts", "src/declaration.d.ts", "playwright.config.ts", ".scripts/**/*.ts", ".scripts/*.ts"]
}
