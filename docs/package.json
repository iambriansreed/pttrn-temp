{
    "name": "ptrn-docs",
    "private": true,
    "version": "0.0.1",
    "license": "CC-BY-4.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pttrn/pttrn",
        "directory": "docs"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite-node ./.scripts/build.ts",
        "meta": "vite-node ./.scripts/meta.ts",
        "dev": "vite-node ./.scripts/dev.ts",
        "lint": "eslint && tsc -b",
        "lint:fix": "eslint --fix",
        "lint:css": "npx stylelint '**/*.scss'",
        "lint:css:fix": "npx stylelint '**/*.scss' --fix",
        "test:dev": "TEST_URL=http://localhost:8055 playwright test",
        "test": "playwright test",
        "test:a11y": "PTTRN_A11Y=1 playwright test",
        "preview": "vite preview --host 127.0.0.1 --port 8055 --strictPort",
        "test:visual": "PTTRN_VISUAL=1 playwright test",
        "test:visual:update": "PTTRN_VISUAL=1 playwright test --update-snapshots"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tslib": "^2.8.1"
    },
    "dependencies": {
        "@axe-core/playwright": "^4.10.1",
        "@ptrn/icons": "*",
        "@ptrn/styles": "*",
        "@ptrn/react": "*",
        "@ptrn/web": "*",
        "axe-core": "^4.10.2",
        "highlight.js": "^11.11.1",
        "markdown-to-jsx": "^7.7.4",
        "marked": "^15.0.6",
        "react-live": "^4.1.8",
        "react-router-dom": "^7.0.1",
        "store": "^2.0.12"
    },
    "devDependencies": {
        "@cspell/eslint-plugin": "^9.4.0",
        "@eslint/css": "^0.14.1",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.50.1",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/node": "^22.13.4",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.5",
        "@types/store": "^2.0.5",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^15.11.0",
        "http-server": "^14.1.1",
        "json-schema": "^0.4.0",
        "prettier": "^3.4.2",
        "prettier-plugin-jsdoc": "^1.3.0",
        "puppeteer": "^25.14.0",
        "sass": "^1.82.0",
        "sass-embedded": "^1.81.0",
        "simple-git": "^3.27.0",
        "stylelint": "^16.19.1",
        "stylelint-config-standard": "^38.0.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "tsx": "^4.19.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.49.0",
        "typescript-json-schema": "^0.65.1",
        "vite": "^6.3.5",
        "vite-node": "^3.2.3",
        "vite-plugin-run": "^0.6.1",
        "watcher": "^2.3.1"
    }
}
