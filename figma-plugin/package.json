{
    "name": "ptrn-figma-plugin",
    "version": "0.0.1",
    "license": "MIT",
    "description": "Figma plugin that exports Pattern Design System tokens as DTCG token files and CSS stylesheets.",
    "engines": {
        "node": ">=24"
    },
    "main": "code.js",
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "node scripts/build.mjs --watch",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "pretest": "npm run build",
        "test": "node --test \"tests/**/*.test.mjs\""
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@figma/eslint-plugin-figma-plugins": "^1.0.0",
        "@figma/plugin-typings": "^1.142.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^15.12.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "private": true
}
