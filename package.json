{
    "name": "pttrn",
    "private": true,
    "version": "0.0.1",
    "license": "CC-BY-4.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "docs",
        "figma-plugin"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "npm run build --workspace @ptrn/icons && npm run build --workspace @ptrn/react && npm run build --workspace @ptrn/web",
        "build:docs": "npm run build --workspace ptrn-docs",
        "build:plugin": "npm run build --workspace ptrn-figma-plugin",
        "dev:docs": "npm run dev --workspace ptrn-docs",
        "dev": "npm run dev:docs",
        "lint": "npm run lint --workspaces --if-present",
        "lint:fix": "npm run lint:fix --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "pretty": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "^3.5.3",
        "prettier-plugin-jsdoc": "^1.3.2",
        "tsx": "^4.23.15"
    }
}
